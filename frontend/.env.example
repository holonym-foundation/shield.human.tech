# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/aztec_bridge"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 characters — enforced at signing time. `openssl rand -hex 32`
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="7d"

# ─── Network selection ──────────────────────────────────────────────────────────
# Which Aztec network this deployment targets. Drives RPC/node URLs and UI labels.
# Set per Vercel project: "testnet" for testnet.shield.human.tech, "mainnet" for prod.
# One of: devnet | testnet | mainnet
NEXT_PUBLIC_AZTEC_ENV="testnet"

# ─── L1 / Ethereum RPC (client) ──────────────────────────────────────────────────
# L1 RPC used by the bridge UI, picked by NEXT_PUBLIC_AZTEC_ENV (Sepolia for testnet/devnet,
# mainnet for mainnet). Only the one matching the active env needs to be set.
NEXT_PUBLIC_L1_RPC_SEPOLIA="https://ethereum-sepolia-rpc.publicnode.com"
NEXT_PUBLIC_L1_RPC_MAINNET="https://ethereum-rpc.publicnode.com"

# ─── Aztec node (L2) ──────────────────────────────────────────────────────────────
# L2 node URL per env (may embed an API key). Only the active env's URL needs to be set.
NEXT_PUBLIC_AZTEC_NODE_DEVNET="https://v4-devnet-3.aztec-labs.com"
NEXT_PUBLIC_AZTEC_NODE_TESTNET="https://v5.testnet.rpc.aztec-labs.com"
NEXT_PUBLIC_AZTEC_NODE_MAINNET="https://aztec-mainnet.drpc.org"

# ─── Faucet / Alchemy (server) ────────────────────────────────────────────────────
# Faucet is enabled off-mainnet (testnet/devnet) and gated off on mainnet.
FAUCET_PRIVATE_KEY="0x..."
ALCHEMY_API_KEY=""

# ─── WalletConnect ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ─── SIWE auth domain ──────────────────────────────────────────────────────────
# Optional. A deployment already accepts the host of the network it serves
# (mainnet builds shield.human.tech, testnet builds testnet.shield.human.tech),
# and localhost outside production, so this is only for an extra hostname the
# same deployment is served on. Single host or comma-separated.
# Never list another environment's host: the signed domain is all a user sees
# before approving, so mainnet must not honour a signature approved for testnet.
AUTH_EXPECTED_DOMAIN=""

# ─── Deposit cap (server) ──────────────────────────────────────────────────────
# Cumulative per-user deposit cap in USD. '' or '0' disables it (typical for testnet).
BRIDGE_MAX_DEPOSIT_USD=""

# ─── Travel Rule threshold (server) ────────────────────────────────────────────
# Cumulative per-human lifetime L1→L2 volume (USD) at or above which the passport
# tier is refused and POCH (Clean Hands) is required. '' or '0' disables it.
TRAVEL_RULE_THRESHOLD_USD="1000"

# ─── Attestation: POCH (Clean Hands) ──────────────────────────────────────────
# Private key of the attester that signs clean-hands attestations.
# Must match the humanIdAttester address configured in the L1 TokenPortal contract.
POCH_ATTESTER_PRIVATE_KEY=""

# Circuit ID for clean-hands attestation (must match L1/L2 contract config)
CLEAN_HANDS_CIRCUIT_ID="1"

# Action ID for Holonym API (default: 123456789)
CLEAN_HANDS_ACTION_ID="123456789"

# Holonym API base URL (default: https://api.holonym.io)
# HOLONYM_API_URL="https://api.holonym.io"

# ─── Attestation: Passport ────────────────────────────────────────────────────
# Private key of the signer for passport-based max-amount attestations.
# Must match the passportSigner address configured in the L1 TokenPortal contract.
PASSPORT_SIGNER_PRIVATE_KEY=""

# L2 Grumpkin keys for Schnorr attestation (must match L2 bridge contract config)
L2_POCH_ATTESTER_PRIVATE_KEY=""
L2_PASSPORT_SIGNER_PRIVATE_KEY=""

# Gitcoin Passport API credentials
PASSPORT_API_KEY=""
PASSPORT_SCORER_ID=""

# ─── Embedded Passport widget ─────────────────────────────────────────────────
# Keyless on/off flag for the in-app Passport score widget (embedded
# verification, Phase 1). Set to "true" to render the widget; anything else
# keeps the out-link fallback to app.passport.xyz. No API key is exposed to the
# browser: the widget's embed calls are proxied through /api/passport-embed,
# which injects the SERVER-only PASSPORT_API_KEY above. The scorer id below is a
# non-secret identifier used to build the request path.
NEXT_PUBLIC_PASSPORT_EMBED_ENABLED="false"
NEXT_PUBLIC_PASSPORT_SCORER_ID=""

# Minimum passport score to qualify (default: 20)
PASSPORT_SCORE_THRESHOLD="20"

# Max deposit amount for passport attestation (in token base units, default: 1e9 = 1000 USDC)
PASSPORT_MAX_AMOUNT="1000000000"
