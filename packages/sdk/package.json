{
  "name": "@human.tech/clean.sdk",
  "version": "0.2.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holonym-foundation/shield.human.tech.git",
    "directory": "packages/sdk"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@alejoamiras/private-fee-juice": "6.0.0-rc.1",
    "@aztec-foundation/aztec-standards": "6.0.0-rc.1",
    "@aztec-labs/aztec.js": "6.0.0-rc.1",
    "@aztec-labs/ethereum": "6.0.0-rc.1",
    "@aztec-labs/foundation": "6.0.0-rc.1",
    "@aztec-foundation/l1-artifacts": "6.0.0-rc.1",
    "@aztec-labs/stdlib": "6.0.0-rc.1",
    "@aztec-labs/wallet-sdk": "6.0.0-rc.1",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "axios": "^1.13.6",
    "siwe": "^3.0.0",
    "viem": "^2.22.8"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
